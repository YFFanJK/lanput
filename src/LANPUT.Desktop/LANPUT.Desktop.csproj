<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LANPUT.Desktop</AssemblyName>
    <Version>0.9.5</Version>
    <Product>LANPUT</Product>
    <Description>LANPUT cross-platform preview</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>../LANPUT.Windows/Assets/LANPUT.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LANPUT.Core/LANPUT.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <AvaloniaResource Include="../LANPUT.Windows/Assets/logo.png" Link="Assets/logo.png" />
    <AvaloniaResource Include="../SharedAssets/cinema-hall.jpg" Link="Assets/cinema-hall.jpg" />
    <AvaloniaResource Include="../LANPUT.Windows/Assets/LANPUT.ico" Link="Assets/LANPUT.ico" />
  </ItemGroup>
</Project>
