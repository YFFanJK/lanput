<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LANPUT</AssemblyName>
    <Product>LANPUT</Product>
    <Title>LANPUT</Title>
    <Description>LANPUT Windows 局域网投屏接收器</Description>
    <Version>0.9.5</Version>
    <FileVersion>0.9.5.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/LANPUT.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets/LANPUT.ico" />
    <Resource Include="Assets/logo.png" />
    <Resource Include="Assets/app-icon.png" />
    <Resource Include="../SharedAssets/cinema-hall.jpg" Link="Assets/cinema-hall.jpg" />
    <Resource Include="../SharedAssets/music-room-background.jpg" Link="Assets/music-room-background.jpg" />
    <Resource Include="../SharedAssets/vinyl-record.png" Link="Assets/vinyl-record.png" />
    <Resource Include="../SharedAssets/tonearm.png" Link="Assets/tonearm.png" />
    <ProjectReference Include="../LANPUT.Core/LANPUT.Core.csproj" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
</Project>
