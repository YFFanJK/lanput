     <TextBlock x:Name="PositionLabel" Text="00:00:00" FontSize="12" Foreground="#9FA4AD" VerticalAlignment="Center"/>
     <Slider MouseMove="MusicSeek_MouseMove" MouseLeave="MusicSeek_MouseLeave" x:Name="PositionSlider" AutomationProperties.Name="播放进度" AutomationProperties.HelpText="左右方向键调整进度，Home 和 End 跳到开头或结尾" Grid.Column="1" Margin="16,0" Minimum="0" Maximum="1" SmallChange="5000" LargeChange="30000" LostMouseCapture="Seek_CaptureLost" KeyUp="Seek_KeyUp"/>
     <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="00:00:00" FontSize="12" Foreground="#9FA4AD" VerticalAlignment="Center"/>
    </Grid>
    <Grid x:Name="PlaybackButtonsGrid" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="PlaybackTransport" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="PlayButton" Background="#E8C87A" Foreground="#2A2010" BorderThickness="0" Padding="11" Width="39" Height="38" Click="PlayPause_Click" ToolTip="播放 / 暂停 · 空格" AutomationProperties.Name="播放 / 暂停"><Path x:Name="PlayGlyph" Data="M8 5l11 7-11 7Z" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      <Button x:Name="StopMediaButton" Style="{StaticResource IconButton}" ToolTip="停止播放" AutomationProperties.Name="停止播放" Click="StopPlayback_Click"><Path Data="M6 6h12v12H6Z" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      <Border x:Name="TransportDivider" Height="30" Width="1" Background="#262C35" Margin="12,0,16,0"/>
     </StackPanel>
     <StackPanel x:Name="PlaybackTrackDetails" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
      <TextBlock x:Name="MediaTitle" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="等待影片" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="PlaybackState" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="尚无影片" FontSize="12" Foreground="#86909B" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel x:Name="PlaybackRight" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="PlaybackInfoButton" Content="播放信息" Style="{StaticResource GhostButton}" Padding="10,8" ToolTip="播放信息 · Ctrl+I" AutomationProperties.Name="播放信息" Click="PlaybackInfo_Click"/>
      <Button x:Name="MuteButton" Style="{StaticResource IconButton}" ToolTip="静音 · M" AutomationProperties.Name="静音" Click="Mute_Click"><Path x:Name="MuteGlyph" Data="M3 9h5l5-4v14l-5-4H3Z M17 8a6 6 0 0 1 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/></Button><Slider x:Name="VolumeSlider" Width="82" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="70" ValueChanged="Volume_Changed" ToolTip="音量" AutomationProperties.Name="音量" Margin="8,0,18,0"/>
      <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" ToolTip="进入全屏 · F / F11" AutomationProperties.Name="进入全屏 · F / F11" Click="Fullscreen_Click"><Path x:Name="FullscreenGlyph" Data="{StaticResource ExpandScreenGeometry}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <Grid x:Name="FooterPanel" Grid.Row="4" Margin="24,0,22,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="FooterHint" Text="LANPUT 0.9.5" Foreground="#858D97" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <TextBlock Grid.Column="1" Text="空格 播放    ← → 进度    M 静音    F 全屏" FontSize="12" Foreground="#828A94" VerticalAlignment="Center" Margin="20,0,0,0"/>
  </Grid>
  <Popup x:Name="SettingsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SettingsButton}" HorizontalOffset="-310" VerticalOffset="10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
   <Border x:Name="SettingsPanel" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" Width="360" TextElement.Foreground="{StaticResource TextPrimary}" Background="#171B21" BorderBrush="#2C323B" BorderThickness="1" CornerRadius="12" Padding="24" PreviewKeyDown="Overlay_KeyDown">
    <StackPanel>
     <Grid Margin="0,0,0,18"><TextBlock Text="接收设置" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseSettingsButton" Content="关闭" Click="CloseSettings_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/></Grid>
     <ScrollViewer x:Name="SettingsScroll" MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
       <TextBlock Text="设备名称" FontSize="12" Foreground="#A3A9B2" Margin="0,0,0,8"/><TextBox x:Name="DeviceName" AutomationProperties.Name="投屏设备名称" MaxLength="60"/>
       <Grid Margin="0,18,0,8"><TextBlock Text="与手机同一局域网的网卡" FontSize="12" Foreground="#A3A9B2"/><Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" Style="{StaticResource GhostButton}" Padding="0" HorizontalAlignment="Right"/></Grid>
       <ComboBox x:Name="NetworkBox" AutomationProperties.Name="接收网卡" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" FontSize="12"/>
       <TextBlock Text="停止接收后可修改名称与网卡；下次启动接收时保存。" Foreground="#939AA4" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,18"/>
       <Button x:Name="ConnectionCheckButton" Content="连接检查" Click="ConnectionCheck_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,0,0,8"/>
       <TextBlock x:Name="ConnectionCheckSummary" Text="开始接收前将检查网卡和接收端口；检查不会修改网络设置。" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Content="开始接收" Background="#E8C87A" Foreground="#2A2010" BorderThickness="0" Click="Start_Click"/>
        <Button x:Name="StopButton" Grid.Column="2" Content="停止接收" IsEnabled="False" Click="Stop_Click"/>
       </Grid>
       <Border Height="1" Background="#2A3039" Margin="0,23,0,20"/>
       <TextBlock Text="高级与排查" Foreground="#A3A9B2" FontSize="12" Margin="0,0,0,10"/>
       <CheckBox x:Name="AutoReceiveBox" Content="启动 LANPUT 后自动开始接收" ToolTip="仅影响下次启动；使用之前成功接收时保存的网卡，不设置 Windows 开机启动" Click="AutoReceive_Click" Margin="0,0,0,12"/>
       <CheckBox x:Name="KeepAwakeBox" Content="播放时保持屏幕与电脑唤醒" Click="DesktopOption_Click" Margin="0,0,0,12"/>
       <CheckBox x:Name="CloseToTrayBox" Content="关闭窗口时收起到托盘" Click="DesktopOption_Click" Margin="0,0,0,12"/>
       <Button Content="收起到托盘" Click="HideToTray_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
       <TextBlock Text="窗口与音量自动记忆。启用关闭到托盘后，请从托盘菜单退出；网络恢复后可能需要手机重新投放。" TextWrapping="Wrap" Foreground="#939AA4" FontSize="12" Margin="0,0,0,12"/>
       <CheckBox x:Name="InterfaceAnimationsBox" Content="界面动画（遵循系统动态效果设置）" Click="InterfaceAnimations_Click" FontSize="12" Margin="0,0,0,12"/>
       <CheckBox x:Name="CompatibilityBox" Content="兼容渲染（记住选择；切换后重新投屏）" Click="Compatibility_Click" FontSize="12"/>
       <Button Content="打开网络设置" Click="NetworkSettings_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,15,0,0"/>
       <Border Height="1" Background="#2A3039" Margin="0,23,0,20"/>
       <TextBlock Text="软件更新" FontSize="15" Margin="0,0,0,12"/>
       <TextBlock Text="更新信息地址（HTTPS JSON）" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
       <TextBox x:Name="UpdateFeedBox" AutomationProperties.Name="更新地址" ToolTip="填写发布服务器上的 latest.json 地址" Margin="0,0,0,12"/>
       <CheckBox x:Name="AutoUpdateCheckBox" Content="启动后在线检查新版本" Margin="0,0,0,12"/>
       <WrapPanel Margin="0,0,0,12">
        <Button Content="保存更新设置" Click="SaveUpdateOptions_Click" Margin="0,0,8,0"/>
        <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates_Click"/>
       </WrapPanel>
       <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"/>
      </StackPanel>
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Popup>
  <Popup x:Name="PlaybackInfoPopup" Placement="Center" PlacementTarget="{Binding ElementName=LayoutRoot}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
   <Border x:Name="PlaybackInfoPanel" Width="540" Background="#14171D" BorderBrush="#2C323B" BorderThickness="1" CornerRadius="12" Padding="24" TextElement.Foreground="{StaticResource TextPrimary}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" PreviewKeyDown="Overlay_KeyDown">
    <StackPanel>
     <Grid Margin="0,0,0,14"><TextBlock Text="播放信息" FontSize="19" FontWeight="SemiBold"/><Button x:Name="ClosePlaybackInfoButton" Content="关闭" Click="ClosePlaybackInfo_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/></Grid>
     <TextBox x:Name="PlaybackInfoText" AutomationProperties.Name="当前播放信息" Height="390" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#10131A" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"/>
     <TextBlock Text="打开时每秒刷新。标称帧率来自片源，不代表实际输出帧率；帧数为引擎累计值。图片不显示视频帧率。诊断导出包含这些参数。" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,14,0,0"/>
    </StackPanel>
   </Border>
  </Popup>
  <Popup x:Name="DiagnosticsPopup" Placement="Center" PlacementTarget="{Binding ElementName=LayoutRoot}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
   <Border x:Name="DiagnosticsPanel" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" TextElement.Foreground="{StaticResource TextPrimary}" Width="660" Background="#14171D" BorderBrush="#2C323B" BorderThickness="1" CornerRadius="12" Padding="24" PreviewKeyDown="Overlay_KeyDown">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,17"><TextBlock Text="播放与连接诊断" FontSize="19" FontWeight="SemiBold"/><Button x:Name="CloseDiagnosticsButton" Content="关闭" Click="CloseDiagnostics_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/></Grid>
     <TextBox x:Name="LogBox" AutomationProperties.Name="脱敏诊断记录" Grid.Row="1" Height="275" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#10131A" BorderBrush="{StaticResource InputBorder}" Foreground="#B0B4BC" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
     <WrapPanel Grid.Row="2" Margin="0,18,0,0">
      <Button x:Name="ProbeButton" Content="检测当前媒体" Click="Probe_Click" Margin="0,0,8,0"/>
      <Button x:Name="CopyDiagnosticsButton" Content="复制诊断" Click="Copy_Click" Margin="0,0,8,0"/>
      <Button Content="导出诊断" Click="ExportDiagnostics_Click" Margin="0,0,8,0"/>
      <Button Content="日志目录" Click="Logs_Click" Style="{StaticResource GhostButton}"/>
     </WrapPanel>
    </Grid>
   </Border>
  </Popup>
 </Grid>
 </Border>
</Window>
