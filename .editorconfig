root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,props}]
indent_style = space
indent_size = 4

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[*.cmd]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
